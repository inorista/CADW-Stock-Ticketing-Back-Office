<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="CADW Cucumber suite" parallel="methods" thread-count="2" data-provider-thread-count="2">
    <listeners>
        <listener class-name="com.cadw.automation.reporting.TestReportListener"/>
    </listeners>
    <test name="CADW BDD scenarios">
        <classes>
            <class name="com.cadw.automation.bdd.runner.CucumberTest"/>
        </classes>
    </test>
</suite>
