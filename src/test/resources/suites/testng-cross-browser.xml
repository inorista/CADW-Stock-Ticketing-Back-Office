<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="CADW native TestNG cross-browser suite" parallel="tests" thread-count="3">
    <listeners>
        <listener class-name="com.cadw.automation.reporting.TestReportListener"/>
    </listeners>
    <test name="Chrome">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.cadw.automation.tests.StockReadOnlyTest"/>
        </classes>
    </test>
    <test name="Firefox">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.cadw.automation.tests.StockReadOnlyTest"/>
        </classes>
    </test>
    <test name="Edge">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.cadw.automation.tests.StockReadOnlyTest"/>
        </classes>
    </test>
</suite>
