<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="CADW TestNG unit suite" parallel="classes" thread-count="2">
    <listeners>
        <listener class-name="com.cadw.automation.reporting.TestReportListener"/>
    </listeners>
    <test name="Configuration and browser state tests">
        <classes>
            <class name="com.cadw.automation.config.EnvironmentConfigTest"/>
            <class name="com.cadw.automation.state.BrowserStateManagerTest"/>
        </classes>
    </test>
</suite>
